{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ticket-intelligence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "EVENT_PROVIDER": "roboticket",
    "EVENT_HOME_TEAM": "Lech Poznań",
    "SUPABASE_URL": "https://oyuyuyphugcsyqsfsulv.supabase.co"
  }
}
